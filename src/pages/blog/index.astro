---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import PostShelf from '../../components/PostShelf.astro';
import { calculateReadingTime } from '../../utils/readingTime';

const isDev = import.meta.env.DEV;

const allPosts = await getCollection('blog', ({ data }) => {
  if (isDev) return true;
  return !data.draft && data.publishDate <= new Date();
});

const libraries = [
  { key: 'wit', label: 'WiT', fullName: "What's in Tech", description: "WiT — What's in Tech: posts on software engineering, architecture, and tooling." },
  { key: 'tomm', label: 'TomM', fullName: 'Top of my Mind', description: "TomM — Top of my Mind: whatever's occupying my thoughts, tech or not." },
] as const;

const posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Deterministic book colors from slug hash
const bookColors = [
  { cover: '#8B3A2A', spine: '#5c2418' },
  { cover: '#2A5C45', spine: '#1a3c2d' },
  { cover: '#1E3A5F', spine: '#122440' },
  { cover: '#4A2060', spine: '#2e1040' },
  { cover: '#5C3317', spine: '#3a1f0e' },
  { cover: '#2D4A30', spine: '#1c301e' },
  { cover: '#7A1E3A', spine: '#4e1224' },
  { cover: '#1E4A4A', spine: '#122e2e' },
];

function getBookColors(slug: string) {
  let hash = 0;
  for (const ch of slug) hash = ch.charCodeAt(0) + ((hash << 5) - hash);
  return bookColors[Math.abs(hash) % bookColors.length];
}
---

<BaseLayout
  title="Blog | RishabhWrites"
  description="All posts on software engineering, architecture, and tooling."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">

    <header class="library-header">
      <p class="library-eyebrow">The Archive</p>
      <h1 class="library-title">The Library</h1>
      <p class="library-subtitle" id="library-count">
        {posts.length} {posts.length === 1 ? 'volume' : 'volumes'} in the collection
      </p>

      <nav aria-label="Filter by library" class="library-filter">
        <button type="button" class="library-filter-btn" data-lib="all" aria-current="true">
          All
        </button>
        {libraries.map((lib) => (
          <button
            type="button"
            class="library-filter-btn"
            data-lib={lib.key}
            aria-current="false"
            title={lib.fullName}
          >
            {lib.label}
          </button>
        ))}
      </nav>

      <p class="library-desc" id="library-desc" hidden></p>
    </header>

    {posts.length === 0 ? (
      <p style="color: var(--color-text-muted);">No posts published yet.</p>
    ) : (
      <>
        <p class="library-empty" id="library-empty" hidden style="color: var(--color-text-muted);">
          No posts in this section yet.
        </p>
        {posts.map((post) => {
          const slug = post.data.slug ?? post.slug;
          const { cover, spine } = getBookColors(slug);
          return (
            <PostShelf
              title={post.data.title}
              slug={slug}
              description={post.data.description}
              publishDate={post.data.publishDate}
              readingTime={calculateReadingTime(post.body)}
              tags={post.data.tags}
              coverColor={cover}
              spineColor={spine}
              draft={post.data.draft}
              library={post.data.library}
            />
          );
        })}
      </>
    )}

  </div>
</BaseLayout>

<script>
  const LIBRARY_DESCRIPTIONS: Record<string, string> = {
    wit: "WiT — What's in Tech: posts on software engineering, architecture, and tooling.",
    tomm: "TomM — Top of my Mind: whatever's occupying my thoughts, tech or not.",
  };

  const buttons = document.querySelectorAll<HTMLButtonElement>('.library-filter-btn');
  const shelves = document.querySelectorAll<HTMLElement>('.post-shelf');
  const countEl = document.getElementById('library-count');
  const descEl = document.getElementById('library-desc');
  const emptyEl = document.getElementById('library-empty');

  function applyFilter(lib: string | null, { push = false }: { push?: boolean } = {}) {
    buttons.forEach((btn) => {
      btn.setAttribute('aria-current', btn.dataset.lib === (lib ?? 'all') ? 'true' : 'false');
    });

    let visibleCount = 0;
    shelves.forEach((shelf) => {
      const isMatch = !lib || shelf.dataset.library === lib;
      shelf.hidden = !isMatch;
      if (isMatch) visibleCount++;
    });

    if (countEl) {
      countEl.textContent = `${visibleCount} ${visibleCount === 1 ? 'volume' : 'volumes'} in the collection`;
    }

    if (descEl) {
      if (lib && LIBRARY_DESCRIPTIONS[lib]) {
        descEl.textContent = LIBRARY_DESCRIPTIONS[lib];
        descEl.hidden = false;
      } else {
        descEl.hidden = true;
      }
    }

    if (emptyEl) {
      emptyEl.hidden = shelves.length === 0 || visibleCount !== 0;
    }

    if (push) {
      const url = lib ? `/blog?lib=${lib}` : '/blog';
      history.pushState({ lib }, '', url);
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lib = btn.dataset.lib === 'all' ? null : btn.dataset.lib ?? null;
      applyFilter(lib, { push: true });
    });
  });

  window.addEventListener('popstate', () => {
    applyFilter(new URLSearchParams(location.search).get('lib'));
  });

  const initialLib = new URLSearchParams(location.search).get('lib');
  applyFilter(initialLib && LIBRARY_DESCRIPTIONS[initialLib] ? initialLib : null);
</script>

<style>
  .library-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .library-eyebrow {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-ornament);
    margin-bottom: 6px;
  }

  .library-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 6px;
    border: none;
    padding: 0;
  }

  .library-subtitle {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }

  .library-filter {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
  }

  .library-filter-btn {
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
    font-family: inherit;
    color: var(--color-text-muted);
    background-color: transparent;
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
  }

  .library-filter-btn:hover {
    color: var(--color-heading);
  }

  .library-filter-btn[aria-current='true'] {
    color: var(--color-bg);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .library-desc {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 4px 0 0;
  }
</style>
